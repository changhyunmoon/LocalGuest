## 6) 코딩 컨벤션

### 파일명
- 컴포넌트: PascalCase (LoginPage.jsx)
- 유틸: camelCase (apiClient.js)
- 상수: UPPER_SNAKE_CASE (API_BASE_URL)

### 함수명
- 이벤트 핸들러: handle 접두사 (handleLogin, handleSubmit)
- API 호출: fetch 접두사 (fetchGuideList, fetchUserInfo)
- boolean: is/has 접두사 (isAuthenticated, hasPermission)

### 상태 관리
const [email, setEmail] = useState('');
const [guides, setGuides] = useState([]);
const [loading, setLoading] = useState(false);

const { isAuthenticated, user, login, logout } = useAuth();

const { data, isLoading, error } = useQuery(['guides'], fetchGuides);

### API 호출 패턴
export const apiClient = async (url, options = {}) => {
  const token = localStorage.getItem('accessToken');
  
  const config = {
    ...options,
    headers: {
      'Content-Type': 'application/json',
      ...options.headers,
      ...(token && { Authorization: `Bearer ${token}` })
    }
  };
  
  const response = await fetch(`${API_BASE_URL}${url}`, config);
  
  if (response.status === 401) {
    const refreshToken = localStorage.getItem('refreshToken');
    if (refreshToken) {
      const newToken = await reissueToken(refreshToken);
      if (newToken) {
        return apiClient(url, options);
      }
    }
    logout();
    window.location.href = '/login';
    return;
  }
  
  if (!response.ok) {
    const error = await response.json();
    throw new Error(error.message || '요청 실패');
  }
  
  return response.json();
};

### 에러 처리
try {
  const response = await apiClient('/api/...');
  setData(response);
  alert('성공했습니다.');
} catch (error) {
  console.error('[Component Name Error]', error);
  
  if (error.message) {
    alert(error.message);
  } else {
    alert('요청 처리 중 오류가 발생했습니다.');
  }
} finally {
  setLoading(false);
}

